# Copy to .env (never commit .env).

# Deploy target (scripts/deploy.py). Prefer an SSH key over a password.
server_host: 0.0.0.0
server_user: root
# server_key: C:/Users/you/.ssh/id_ed25519
server_password:

# Optional analytics. Trackers load only after the visitor accepts the KVKK cookie banner.
REACT_APP_GA4_ID=
REACT_APP_META_PIXEL_ID=
